# MongoDB Configuration
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/
DB_NAME=cursy_db

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
PORT=8080
GIN_MODE=release

# IDrive e2 / S3 Configuration
IDRIVE_ENDPOINT=https://your-endpoint.s3.us-west-1.idrivee2-22.com
IDRIVE_ACCESS_KEY=your-access-key
IDRIVE_SECRET_KEY=your-secret-key
IDRIVE_BUCKET=cursy-images
IDRIVE_REGION=us-east-1
# Opcional: Si tienes un dominio personalizado o CDN
IDRIVE_PUBLIC_URL=https://your-public-url.com
